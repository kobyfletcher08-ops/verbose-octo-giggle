# Local configuration. No seed phrase or private key belongs in this file.
BOT_TOKEN=
# Optional: bypass one-time pairing with your numeric Telegram user ID.
OWNER_TELEGRAM_ID=

# One-time hosting configuration for the wallet form that opens inside Telegram.
# Telegram requires HTTPS. Point this origin at this bot's HTTP server through a TLS proxy.
APP_PUBLIC_URL=
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
# Docker Compose: set a real domain with DNS pointing at your server.
APP_DOMAIN=

# Public RPCs are provided for initial read-only checks. Use reliable RPCs for execution.
BASE_RPC_URL=https://mainnet.base.org
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BASE_EXECUTOR_ADDRESS=
BSC_EXECUTOR_ADDRESS=

# paper = quote + full eth_call simulation when a wallet and executor are configured.
# live = transactions can be broadcast after /trade on in the private bot chat.
TRADING_MODE=paper
FUNDING_MODE=flashloan
TRADE_SIZE=100
MAX_TRADE_SIZE=1000
MIN_NET_PROFIT=1
SLIPPAGE_BPS=30
SCAN_INTERVAL_SECONDS=30
TRADE_COOLDOWN_SECONDS=120
ALERT_COOLDOWN_SECONDS=600
MIN_POOL_QUOTE_RESERVE=25000
MAX_RESERVE_SHARE_BPS=100
MAX_DAILY_TRADES=5
MAX_BLOCK_AGE_SECONDS=30
MAX_QUOTE_AGE_SECONDS=10

BASE_MAX_GAS_FEE_NATIVE=0.0002
BASE_DAILY_GAS_BUDGET_NATIVE=0.001
BASE_MAX_GAS_PRICE_GWEI=3
BASE_EXTRA_FEE_CAP_NATIVE=0.00005
BSC_MAX_GAS_FEE_NATIVE=0.002
BSC_DAILY_GAS_BUDGET_NATIVE=0.01
BSC_MAX_GAS_PRICE_GWEI=10

WALLET_FILE=./data/wallet.json
# Optional for unattended live startup: absolute path to a password file with mode 600.
# Leaving it empty starts locked; unlock through /unlock in Telegram.
WALLET_PASSWORD_FILE=
STATE_FILE=./data/bot-state.json
